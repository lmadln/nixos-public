layout {

    focus-ring {
        active-color   "#5eafb6"
        inactive-color "#171818"
        urgent-color   "#dfa7a0"
    }

    border {
        active-color   "#5eafb6"
        inactive-color "#171818"
        urgent-color   "#dfa7a0"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#5eafb6"
        inactive-color "#133739"
        urgent-color   "#dfa7a0"
    }

    insert-hint {
        color "#5eafb680"
    }
}

recent-windows {
    highlight {
        active-color "#5eafb6"
        urgent-color "#dfa7a0"
    }
}
