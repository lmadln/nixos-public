layout {

    focus-ring {
        active-color   "#dea79d"
        inactive-color "#1b1a1a"
        urgent-color   "#dfa7a0"
    }

    border {
        active-color   "#dea79d"
        inactive-color "#1b1a1a"
        urgent-color   "#dfa7a0"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#dea79d"
        inactive-color "#5c3732"
        urgent-color   "#dfa7a0"
    }

    insert-hint {
        color "#dea79d80"
    }
}

recent-windows {
    highlight {
        active-color "#dea79d"
        urgent-color "#dfa7a0"
    }
}
