layout {

    focus-ring {
        active-color   "#99b6dd"
        inactive-color "#1a1a1a"
        urgent-color   "#dfa7a0"
    }

    border {
        active-color   "#99b6dd"
        inactive-color "#1a1a1a"
        urgent-color   "#dfa7a0"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#99b6dd"
        inactive-color "#1d3d56"
        urgent-color   "#dfa7a0"
    }

    insert-hint {
        color "#99b6dd80"
    }
}

recent-windows {
    highlight {
        active-color "#99b6dd"
        urgent-color "#dfa7a0"
    }
}
