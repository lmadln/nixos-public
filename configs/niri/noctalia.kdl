layout {

    focus-ring {
        active-color   "#d7a786"
        inactive-color "#1a1919"
        urgent-color   "#dfa7a0"
    }

    border {
        active-color   "#d7a786"
        inactive-color "#1a1919"
        urgent-color   "#dfa7a0"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d7a786"
        inactive-color "#4c3219"
        urgent-color   "#dfa7a0"
    }

    insert-hint {
        color "#d7a78680"
    }
}

recent-windows {
    highlight {
        active-color "#d7a786"
        urgent-color "#dfa7a0"
    }
}
